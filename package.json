{
  "name": "eykt-ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "license": "UNLICENSED",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "solid": "./src/components/*.tsx",
      "types": "./src/components/*.tsx"
    },
    "./controls/*": {
      "solid": "./src/controls/*.tsx",
      "types": "./src/controls/*.tsx"
    },
    "./composable/*": null,
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/base.css": "./src/styles/base.css"
  },
  "scripts": {
    "theme:generate": "tsx scripts/theme/build.ts",
    "css-types": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat camel",
    "css-types:check": "typed-scss-modules \"src/**/*.module.scss\" --exportType default --nameFormat camel --listDifferent",
    "check": "tsc -p tsconfig.lib.json",
    "lint": "oxlint -c oxlint.config.mjs src preview"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.21",
    "solid-js": "^2.0.0-rc.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.16.1",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.79.0",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typed-scss-modules": "^8.1.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
